#!/bin/bash
set -u

TODAY=$(date +%F)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SITE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$SITE_DIR" || {
  echo "Could not open Hugo project root:"
  echo "$SITE_DIR"
  exit 1
}

echo
echo "Create a new News & Media entry"
echo
echo "Press Enter to accept the value shown in [brackets]."
echo "Press Ctrl+C at any time to cancel."
echo

# ─────────── PUBLICATION DATE ───────────

while true; do
  read -r -p "Publication date (YYYY-MM-DD) [$TODAY]: " PUBDATE
  PUBDATE="${PUBDATE:-$TODAY}"

  if [[ ! "$PUBDATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    echo "Please enter the date as YYYY-MM-DD."
    echo
    continue
  fi

  if ! date -j -f "%Y-%m-%d" "$PUBDATE" "+%Y-%m-%d" >/dev/null 2>&1; then
    echo "That isn't a valid calendar date."
    echo
    continue
  fi

  break
done

# ─────────── TITLE ───────────

while true; do
  read -r -p "Title: " TITLE

  if [[ -n "${TITLE// }" ]]; then
    break
  fi

  echo "A title is required."
  echo
done

# ─────────── ID (stable, immutable, drives the folder name) ───────────

NEWS_DIR="$SITE_DIR/content/news"
MAX_NUM=0

for d in "$NEWS_DIR"/n[0-9][0-9][0-9][0-9][0-9][0-9]; do
  [[ -d "$d" ]] || continue
  base="$(basename "$d")"
  num="${base#n}"
  num=$((10#$num))
  if (( num > MAX_NUM )); then
    MAX_NUM=$num
  fi
done

ID=$(printf "n%06d" "$((MAX_NUM + 1))")
FOLDER="$ID"
TARGET="news/${FOLDER}/index.md"
FULL_PATH="$SITE_DIR/content/$TARGET"

if [[ -e "$FULL_PATH" ]]; then
  echo "Computed next id $ID but $FULL_PATH already exists."
  echo "Check content/news for a gap or collision before continuing."
  exit 1
fi

# ─────────── SLUG (human-readable, used only in the URL, not the folder) ───────────

SUGGESTED_SLUG=$(
  printf "%s" "$TITLE" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
)

if [[ -z "$SUGGESTED_SLUG" ]]; then
  echo "The title did not produce a usable slug."
  exit 1
fi

SLUG="$SUGGESTED_SLUG"

while true; do
  read -r -p "Slug [$SLUG]: " ENTERED_SLUG
  ENTERED_SLUG="${ENTERED_SLUG:-$SLUG}"

  SLUG=$(
    printf "%s" "$ENTERED_SLUG" |
      tr '[:upper:]' '[:lower:]' |
      sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
  )

  if [[ -z "$SLUG" ]]; then
    echo "Slug cannot be blank."
    echo
    continue
  fi

  # Slugs don't need to be globally unique (the id in the URL already
  # guarantees that), but warn if one collides so it's not confusing later.
  if grep -rlq "^slug: \"\?${SLUG}\"\?\$" "$NEWS_DIR"/*/index.md 2>/dev/null; then
    echo
    echo "Note: another entry already uses the slug \"$SLUG\"."
    echo "That's fine (the id keeps URLs unique), but you can pick a different one."
    echo
    read -r -p "Use \"$SLUG\" anyway? [Y/n]: " USE_ANYWAY
    USE_ANYWAY="${USE_ANYWAY:-y}"
    case "$USE_ANYWAY" in
      y|Y|yes|YES) break ;;
      *) continue ;;
    esac
  fi

  break
done

# ─────────── CONFIRMATION ───────────

echo
echo "Summary"
echo "-------"
echo "ID:     $ID"
echo "Title:  $TITLE"
echo "Date:   $PUBDATE"
echo "Slug:   $SLUG"
echo

read -r -p "Create entry? [Y/n]: " CONFIRM
CONFIRM="${CONFIRM:-y}"

case "$CONFIRM" in
  y|Y|yes|YES)
    ;;
  *)
    echo "Cancelled."
    exit 0
    ;;
esac

# ─────────── CREATE ENTRY ───────────

echo
echo "Creating content/$TARGET"

if ! hugo new "$TARGET"; then
  echo
  echo "Hugo could not create the entry."
  exit 1
fi

if [[ ! -f "$FULL_PATH" ]]; then
  echo "The expected index.md file was not created."
  exit 1
fi

# Populate id, slug, title, and publication date.
python3 - "$FULL_PATH" "$ID" "$SLUG" "$TITLE" "$PUBDATE" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
entry_id = sys.argv[2]
slug = sys.argv[3]
title = sys.argv[4]
pubdate = sys.argv[5]

lines = path.read_text().splitlines()

for index, line in enumerate(lines):
    if line.startswith("id:"):
        lines[index] = f"id: {entry_id}"
    elif line.startswith("slug:"):
        lines[index] = f"slug: {slug}"
    elif line.startswith("title:"):
        lines[index] = f"title: {json.dumps(title, ensure_ascii=False)}"
    elif line.startswith("date:"):
        lines[index] = f'date: "{pubdate}"'

path.write_text("\n".join(lines) + "\n")
PY

echo
echo "Created:"
echo "content/$TARGET"
echo
echo "URL will be:"
echo "/news/${ID}/${SLUG}/"

if command -v code >/dev/null 2>&1; then
  code "$FULL_PATH"
else
  open "$FULL_PATH"
fi

open "$(dirname "$FULL_PATH")"